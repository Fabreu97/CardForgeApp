# Copy this file to .env, edit the values and run:
#   flutter run --dart-define-from-file=.env
# Do not commit .env (add it to .gitignore).

# true = simulated server (no backend needed); false = the real server
USE_MOCK=true

# true = simulated machine for Bluetooth linking; false = the real transport
# (not built yet, so linking shows "not available" when this is false)
USE_MOCK_BLUETOOTH=true

# Base URL of the server API, without a trailing slash
API_BASE_URL=https://api.cardforge.example

# OAuth client ID of type "Web" from Google Cloud.
# Needed for Google sign-in to return the idToken on Android.
GOOGLE_SERVER_CLIENT_ID=
